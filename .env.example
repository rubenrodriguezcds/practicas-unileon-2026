# Copiar a .env y cambiar los valores. El .env NO se sube a git.

# Postgres (contenedor db; la web usa los mismos)
POSTGRES_DB=gestor
POSTGRES_USER=gestor
POSTGRES_PASSWORD=cambia-esto

# SSH al contenedor db
SSH_USER=soporte
SSH_PASSWORD=cambia-esto

# Usuario admin de la aplicación web (se crea al inicializar la bbdd).
# Cambiarla después exige recrear la bbdd: docker compose down -v
APP_ADMIN_PASSWORD=cambia-esto

# Web: firma de la cookie de sesión. Mínimo 32 caracteres o la web no arranca.
# Generar con: python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=cambia-esto

# Email del admin: a dónde llega su contraseña nueva si la resetea. La API se lo pone al
# arrancar SOLO si aún no tiene (para no pisar uno cambiado a mano).
# AVISO: si el admin ya tiene email, cambiarlo aquí NO sirve. Hay que actualizarlo en la bbdd:
#   docker compose exec db psql -U gestor -d gestor -c "UPDATE usuarios SET email = 'nuevo@correo' WHERE username = 'admin';"
APP_ADMIN_EMAIL=admin@example.com

# Captcha ALTCHA: clave con la que la API firma los retos. No hace falta ninguna cuenta externa,
# pero sí esta clave (mínimo 32 caracteres o la web no arranca). Generar igual que APP_SECRET.
ALTCHA_HMAC_KEY=cambia-esto
# ALTCHA_ENABLED=false desactiva la comprobación: solo para tests o desarrollo.
ALTCHA_ENABLED=true

# Reseteos de contraseña permitidos por hora, por usuario y por IP.
RESET_MAX_POR_HORA=5

# Tamaño máximo de cada documento adjunto a un proyecto, en MB. Los documentos se guardan dentro
# de Postgres: sin límite, cualquiera podría llenar la bbdd.
DOCUMENTO_MAX_MB=50

# Correo para el reseteo de contraseña. Con SMTP_HOST vacío el correo NO se envía: se escribe
# en `docker compose logs web` con la contraseña en claro (solo para desarrollo).
# Brevo (el que usa el proyecto, gratis y sin dominio propio): smtp-relay.brevo.com, 587,
# starttls; SMTP_USER y SMTP_PASSWORD son el login y la clave SMTP de Brevo, y SMTP_FROM el
# remitente verificado en Brevo. Gmail también vale (contraseña de aplicación). Outlook.com
# personal NO: Microsoft ya no permite SMTP con contraseña en esas cuentas.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
